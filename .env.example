# Copy this file to .env and fill in your own MongoDB connection string.
# Do not commit .env to GitHub.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ir_vertical_search_engine

PUREPORTAL_SEED_URL=https://pureportal.coventry.ac.uk/en/organisations/centre-for-healthcare-and-community-transformation/
ALLOWED_DOMAIN=pureportal.coventry.ac.uk
USER_AGENT=SoftwaricaIRSearchEngine/1.0 (student coursework crawler)
CRAWL_DELAY_SECONDS=2.0
REQUEST_TIMEOUT_SECONDS=20
MAX_LISTING_PAGES=3
MAX_PUBLICATIONS=25
